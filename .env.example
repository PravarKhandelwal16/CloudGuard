# CloudGuard Environment Configuration
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret-key-32chars
JWT_SECRET_KEY=change-this-to-a-secure-random-jwt-key-32chars
DATABASE_URL=sqlite:///cloudguard.db
STORAGE_BACKEND=local
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-private-cloudguard-bucket
ENABLE_SNS=false
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:cloudguard-alerts
UPLOAD_MAX_MB=25
MAX_ARCHIVE_UNCOMPRESSED_MB=100
MAX_ARCHIVE_FILES=1000
ML_MODEL_PATH=ml/models/secret_classifier.joblib

