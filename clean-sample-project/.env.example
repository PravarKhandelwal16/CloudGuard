# Example Environment Configuration (Clean Architecture)
# Copy this template to .env and provide your values at deployment.
# Application secrets should be injected via secure environment variables or AWS Secrets Manager.

PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_NAME=CleanSecureService

# Database and API Credentials (leave empty in templates and version control)
DATABASE_URL=
API_KEY=
AWS_DEFAULT_REGION=us-east-1
